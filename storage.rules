rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || 
         request.auth.token.email == 'rasakanu2008@gmail.com');
    }
    
    // Public read for all images
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
